   "source": [
    "s = \"A man, a plan, a canal: Panama\"\n",
    "def is_palindrome(s):\n",
    "    cleaned = [c.lower() for c in s if c.isalnum()]\n",
    "    return cleaned == cleaned[::-1]\n",
    "print(is_palindrome(s))  # Output: True"
   ]
